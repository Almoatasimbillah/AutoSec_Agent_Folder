# =========================================================================
# Autonomous Security Research Agent — Environment Variables
# Copy this file to .env and configure your researcher settings
# =========================================================================

# Researcher Identity & Tag (Injected into security headers)
RESEARCHER_NAME=Security Researcher
RESEARCHER_HANDLE=security_researcher

# Mission Control Web Server Configuration
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Passive Proxy Configuration
PROXY_HOST=127.0.0.1
PROXY_PORT=8085

# Safety & Rate Limiting
DEFAULT_RATE_LIMIT_RPS=5
ENFORCE_ACTION_GATE=true
